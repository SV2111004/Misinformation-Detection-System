# ==============================================================================
# Git Attributes Configuration - Political Misinformation Detection System
# Standardizes line endings across Windows, Linux, and macOS platforms
# ==============================================================================

# Set default behavior to automatically normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text file types
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ipynb text eol=lf

# Windows-specific script files (preserve CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary file types (prevent line ending conversion and corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pkl binary
*.safetensors binary
*.bin binary
*.pt binary
*.pth binary

