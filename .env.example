# ==============================================================================
# Environment Configuration Template
# Project: AI-Powered Agentic System for Political Misinformation Detection,
#          Influence Analysis and Propagation Mitigation
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root: cp .env.example .env
# 2. Update the variable values below according to your local environment.
# 3. NEVER commit your actual '.env' file or active API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI & Uvicorn)
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS Allowed Origins (Comma-separated list of permitted frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Optional LLM Grounding Keys for Hybrid RAG Synthesis
# Note: If no API key is provided, the system automatically uses its built-in
#       deterministic template-based grounded synthesis without external calls.
# ------------------------------------------------------------------------------
# Google Gemini API Key (e.g. for Gemini 1.5 Flash grounded summaries)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (e.g. for GPT-4o-mini grounded summaries)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Frontend Application Configuration (Vite + React 19)
# ------------------------------------------------------------------------------
# Base URL of the running FastAPI backend server
VITE_API_URL=http://127.0.0.1:8000

